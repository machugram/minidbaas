# Copy to .env and fill in. All settings are read with the MDBAAS_ prefix.

# --- Metadata store (the control plane's own Postgres; never a tenant DB) ---
MDBAAS_DATABASE_URL=postgresql+psycopg://mdbaas:mdbaas@metadata-db:5432/mdbaas

# --- Credential encryption (ADR-005) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this KEK lives in a secrets manager / KMS, not in a file.
# During rotation, set PREVIOUS to the old key so existing envelopes still decrypt.
MDBAAS_CREDENTIAL_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key
# MDBAAS_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# --- Data-plane provisioner (Docker) ---
# docker-compose wires this to docker-socket-proxy automatically. For bare-metal
# dev without the proxy, leave DOCKER_HOST unset to use the default local socket.
MDBAAS_DOCKER_BASE_URL=tcp://docker-socket-proxy:2375
MDBAAS_PG_IMAGE_DEFAULT=postgres:16
# Isolate each team's instances on a dedicated bridge network (design-review 1.2).
MDBAAS_PER_TEAM_NETWORKS=true

# --- Instance connectivity (ADR-007): localhost-bound port-per-instance ---
MDBAAS_INSTANCE_BIND_HOST=127.0.0.1
MDBAAS_PORT_RANGE_START=15000
MDBAAS_PORT_RANGE_END=16000

# --- Lifecycle ---
MDBAAS_BACKUP_RETENTION_DAYS=7
MDBAAS_DEFAULT_RPO_HOURS=24
MDBAAS_EXPIRY_GRACE_HOURS=24

# --- API hardening ---
# Comma-separated origins for CORS, or leave empty to disable.
# MDBAAS_CORS_ORIGINS=http://localhost:3000
MDBAAS_RATE_LIMIT_REQUESTS=100
MDBAAS_RATE_LIMIT_WINDOW_SECONDS=60
MDBAAS_MAX_REQUEST_BYTES=1048576
