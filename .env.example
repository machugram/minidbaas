# Copy to .env and fill in. All settings are read with the MDBAAS_ prefix.

# --- Metadata store (the control plane's own Postgres; never a tenant DB) ---
MDBAAS_DATABASE_URL=postgresql+psycopg://mdbaas:mdbaas@metadata-db:5432/mdbaas

# --- Credential encryption (ADR-005) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this key lives in a secrets manager / KMS, not in a file.
MDBAAS_CREDENTIAL_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# --- Data-plane provisioner (Docker) ---
# Leave DOCKER_HOST unset to use the default local socket. For the socket-proxy
# hardening (design-review 1.1) point this at the proxy instead.
# MDBAAS_DOCKER_BASE_URL=tcp://docker-socket-proxy:2375
MDBAAS_PG_IMAGE_DEFAULT=postgres:16

# --- Instance connectivity (ADR-007): localhost-bound port-per-instance ---
MDBAAS_INSTANCE_BIND_HOST=127.0.0.1
MDBAAS_PORT_RANGE_START=15000
MDBAAS_PORT_RANGE_END=16000

# --- Lifecycle ---
MDBAAS_BACKUP_RETENTION_DAYS=7
MDBAAS_DEFAULT_RPO_HOURS=24
MDBAAS_EXPIRY_GRACE_HOURS=24
